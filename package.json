{
  "name": "apotek-digital",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "test:api": "bun run --cwd apps/api test",
    "test:web": "bun run --cwd apps/web test",
    "build:api": "bun run --cwd apps/api build",
    "db:migrate": "bun run --cwd apps/api migrate",
    "db:seed": "bun run --cwd apps/api seed",
    "provision:user": "bun run --cwd apps/api provision:user",
    "build:web": "bun run --cwd apps/web build"
  }
}

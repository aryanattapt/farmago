{
  "name": "@apotek/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/server.ts",
    "start": "bun --env-file ../../.env src/server.ts",
    "migrate": "bun --env-file ../../.env src/interfaces/cli/migrate.ts",
    "seed": "bun --env-file ../../.env src/interfaces/cli/seed.ts",
    "provision:user": "bun --env-file ../../.env src/interfaces/cli/provision-user.ts",
    "test": "bun test --coverage --coverage-reporter=lcov src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "^0.45.4",
    "elysia": "1.4.30",
    "file-type": "22.3.0",
    "nodemailer": "10.3.1",
    "openapi-types": "12.1.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "typescript": "~6.0.3"
  }
}

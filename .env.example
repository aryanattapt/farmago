DATABASE_URL=postgres://apotek:apotek_dev@localhost:5432/apotek
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# SMTP credentials for contact-verification and password-reset email (465 implicit TLS, or 587 with STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SESSION_COOKIE_SECURE=false
RESERVATION_MINUTES=30
UPLOAD_MAX_BYTES=8388608
RETURN_EVIDENCE_MAX_BYTES=26214400
# Generate once with: openssl rand -hex 32. Required to provision internal TOTP accounts.
MFA_ENCRYPTION_KEY=
# Configure payment, courier, and notification adapters before pilot.

# Komerce Shipping Delivery (separate Enterprise API key from Shipping Cost v2).
KOMERCE_DELIVERY_API_KEY=
KOMERCE_DELIVERY_BASE_URL=https://api-sandbox.collaborator.komerce.id
KOMERCE_DELIVERY_BRAND_NAME=FarmaGO
# Set this 64-character random secret in Komerce's webhook callback URL as ?token=...
# Generate with: openssl rand -hex 32
KOMERCE_DELIVERY_WEBHOOK_TOKEN=

# RajaOngkir API v2 (server-side only). Couriers are managed in the rajaongkir_couriers database table.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_PACKAGING_WEIGHT_GRAMS=250
